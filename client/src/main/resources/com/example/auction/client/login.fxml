<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.auction.client.LoginController" styleClass="root-shell">
  <center>
    <VBox alignment="CENTER" spacing="16" maxWidth="470">
      <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
      </padding>
      <Label text="Hệ thống đấu giá trực tuyến" styleClass="page-title"/>
      <Label text="Đăng nhập để xem và quản lý các phiên đấu giá." styleClass="muted" wrapText="true"/>
      <Separator/>
      <GridPane hgap="12" vgap="8">
        <columnConstraints>
          <ColumnConstraints percentWidth="73"/>
          <ColumnConstraints percentWidth="27"/>
        </columnConstraints>
        <Label text="Địa chỉ server"/>
        <Label text="Cổng" GridPane.columnIndex="1"/>
        <TextField fx:id="host" GridPane.rowIndex="1"/>
        <TextField fx:id="port" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
      </GridPane>
      <VBox spacing="8">
        <Label text="Tên đăng nhập"/>
        <TextField fx:id="username" promptText="2–32 ký tự chữ, số hoặc dấu gạch dưới"/>
        <Label text="Mật khẩu"/>
        <PasswordField fx:id="password" promptText="Ít nhất 6 ký tự" onAction="#login"/>
      </VBox>
      <Button fx:id="login" text="Đăng nhập" maxWidth="Infinity" onAction="#login" styleClass="primary" defaultButton="true"/>
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Đăng ký mới:"/>
        <ComboBox fx:id="role" HBox.hgrow="ALWAYS"/>
        <Button fx:id="register" text="Đăng ký" onAction="#register"/>
      </HBox>
      <Label text="BIDDER: người mua • SELLER: người bán" styleClass="muted"/>
      <Label fx:id="feedback" wrapText="true" minHeight="44" styleClass="feedback"/>
    </VBox>
  </center>
</BorderPane>
